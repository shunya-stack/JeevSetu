# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Backend
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./jeevsetu.db
CORS_ORIGINS=http://localhost:5173

# ── AI pipeline (v2): Evon v3.3 analysis + Bhashini ASR/translation/TTS ──

# Evon — OpenAI-compatible chat completions (backend-only, Bearer auth).
# EVON_API_URL must point at the chat-completions endpoint, e.g.
#   https://<your-evon-host>/v1/chat/completions
# The URL is configurable because the deployment in front of the model may
# live anywhere (on-prem, tunnel for hackathon demos, or a permanent host).
# Never commit temporary tunnel URLs as production values.
EVON_API_URL=
EVON_API_KEY=
EVON_MODEL=evon-v3.3
# Evon runs on modest hardware; allow long completions (seconds).
EVON_TIMEOUT=300

# Bhashini — speech recognition, translation and TTS (backend-only).
# Get the API key from your Bhashini account and paste the service's
# compute URLs (they are account/pipeline-specific — returned by the
# pipeline discovery call on the portal). Do NOT invent values.
#
# Supported languages: Odia (or), Hindi (hi), English (en).
# ASR supports explicit language selection; auto language detection is
# enabled with app_language=auto where the configured service supports it.
BHASHINI_API_KEY=
BHASHINI_ASR_URL=
BHASHINI_TRANSLATION_URL=
BHASHINI_TTS_URL=
# Optional: attach the pipeline/service id your account issued if required
BHASHINI_ASR_PIPELINE_ID=
BHASHINI_TRANSLATION_PIPELINE_ID=
BHASHINI_TTS_PIPELINE_ID=

# Provider mode: "live" when Evon+Bhashini credentials exist, "demo" otherwise.
# Demo adapters are transparently labelled DEMO in every response.
AI_PROVIDER_MODE=demo

# Storage
AUDIO_STORAGE_MODE=local
AUDIO_STORAGE_PATH=./uploads
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=jeevsetu-audio

# Safety
# TRIAGE_RULESET_VERSION is fixed in code (demo-v1) — safety changes are code
# reviewed, never configured away.
